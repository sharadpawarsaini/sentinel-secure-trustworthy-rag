# SENTINEL Environment Configuration Template
# Copy this file to .env and configure local/remote values.
# NEVER commit actual API keys or secrets to git.

# Server Configuration
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_DEBUG=True

# LLM Backend Selection (Options: "ollama", "gemini", "openai")
LLM_PROVIDER=ollama
LLM_MODEL=llama3:8b-instruct
LLM_TEMPERATURE=0.0

# Optional Remote API Keys (Required only if LLM_PROVIDER is "gemini" or "openai")
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama Endpoint (Required only if LLM_PROVIDER is "ollama")
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model Configuration (Local SentenceTransformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE_DIR=./data/vectorstore

# NLI Cross-Encoder Configuration (Local HuggingFace model)
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small

# Trust and Security Hyperparameters
TRUST_THRESHOLD_HIGH=0.75
TRUST_THRESHOLD_LOW=0.50
SECURITY_RISK_THRESHOLD=0.70
MAX_MITIGATION_ATTEMPTS=1
